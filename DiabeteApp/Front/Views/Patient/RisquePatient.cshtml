@model Front.ViewModels.RisquePatientViewModel

<h3 class="card-title text-center">Risque de diabète</h3>

<div class="mt-4 text-center">
    @switch (Model.Risque)
    {
        case "Aucun risque":
            <span class="badge bg-success px-3 py-3 fs-5">@Model.Risque</span>
            break;

        case "Risque limité":
            <span class="badge bg-warning text-dark px-3 py-3 fs-5">@Model.Risque</span>
            break;

        case "Danger":
            <span class="badge bg-danger px-3 py-3 fs-5">@Model.Risque</span>
            break;

        case "Apparition précoce":
            <span class="badge bg-dark px-3 py-3 fs-5">@Model.Risque</span>
            break;

        default:
            <span class="badge bg-secondary px-3 py-3 fs-5">@Model.Risque</span>
            break;
    }
</div>